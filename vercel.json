{
  "functions": {
    "src/app/api/process-audio/route.ts": {
      "maxDuration": 300,
      "memory": 3008
    }
  },
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/billing/report-usage",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/security/sweep",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/monthly-usage-report",
      "schedule": "0 15 1 * *"
    },
    {
      "path": "/api/cron/month-end-push",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/weekly-manager-nudge",
      "schedule": "0 15 * * 1"
    }
  ]
}
