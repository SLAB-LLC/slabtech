# Supabase Configuration
# REQUIRED: Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AssemblyAI Configuration
# REQUIRED: For audio transcription and speaker diarization
# Get your API key from https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# Anthropic Configuration
# OPTIONAL: For AI-powered conversation analysis (objections, categories)
# Get your API key from https://console.anthropic.com/
# If not set, conversation analysis will be skipped (non-fatal)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend Configuration
# OPTIONAL: Emails you when someone applies on the home page or orders from the store.
# Without it, inquiries still save to the database — they just arrive silently.
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key
# Who gets notified. Comma-separated for more than one.
INQUIRY_NOTIFY_TO=duncan@slabtraining.com
# From header — this domain must be verified at https://resend.com/domains
RESEND_FROM=SLAB <noreply@slabtraining.com>
# Used for the "Open in admin" link inside the email
NEXT_PUBLIC_SITE_URL=https://slabtraining.com

# Optional: set if ffmpeg is not on PATH
# FFMPEG_PATH="C:\\Users\\you\\AppData\\Local\\Microsoft\\WinGet\\Links\\ffmpeg.exe"

# Speech Detection Configuration (DISABLED BY DEFAULT)
# See SPEECH_DETECTION_NOTES.md for details on this experimental feature
# Uncomment to enable speech detection for large files (>100MB)
# ENABLE_SPEECH_DETECTION=true
# SILENCE_THRESHOLD_DB=-60
# MIN_SILENCE_DURATION=60

# Stripe (billing) - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from https://dashboard.stripe.com/products
STRIPE_PRICE_PLATFORM=price_...
STRIPE_PRICE_AUDIO_DAY=price_...
# $5 per active rep, metered (meter active_reps, aggregation Last) for per-rep companies
STRIPE_PRICE_ACTIVE_REP=price_...
# Stripe meter event name for rep audio days (default rep_audio_days)
STRIPE_METER_EVENT=rep_audio_days
# Stripe meter event name for active reps (default active_reps)
STRIPE_ACTIVE_REP_METER_EVENT=active_reps
# Vercel cron auth (any long random string)
CRON_SECRET=
